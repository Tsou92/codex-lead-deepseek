#!/bin/sh
''''exec "$(d=$0; if [ "${d#*/}" = "$d" ]; then d=./$d; fi; while [ -L "$d" ]; do l=$(readlink "$d"); if [ "${l#/}" != "$l" ]; then d=$l; else d=${d%/*}/$l; fi; done; b=${d%/*}; cd "$b" && pwd)/python" "$0" "$@" # '''
#!/usr/bin/env python3
import os
from pathlib import Path
import subprocess
import sys

sys.dont_write_bytecode = True
root = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(root / "src"))
from leadseek.configuration import load_config

temp = root / ".state/test-tmp"
temp.mkdir(parents=True, exist_ok=True)
env = {**os.environ, "PYTHONPATH": str(root / "src"), "PYTHONDONTWRITEBYTECODE": "1", "TMPDIR": str(temp)}
subprocess.run([sys.executable, "-B", "-m", "unittest", "discover", "-s", "tests", "-v"], cwd=root, env=env, check=True)
node = load_config(root)["node"]
subprocess.run([node, str(root / "tests/test_budget.mjs")], cwd=root, env=env, check=True)
subprocess.run([node, str(root / "tests/test_observe.mjs")], cwd=root, env=env, check=True)
subprocess.run([node, str(root / "tests/test_monitor_history.mjs")], cwd=root, env=env, check=True)
subprocess.run([node, "--test", str(root / "tests/test_legacy_headless.mjs")], cwd=root, env=env, check=True)
