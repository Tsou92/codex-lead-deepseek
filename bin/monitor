#!/bin/sh
# Launch the local read-only task monitor. Default subcommand is "start".
set -e
script="$0"
while [ -L "$script" ]; do
  link=$(readlink "$script")
  case "$link" in
    /*) script="$link" ;;
    *) case "$script" in
         */*) script="${script%/*}/$link" ;;
         *) script="$link" ;;
       esac ;;
  esac
done
case "$script" in
  */*) DIR=${script%/*} ;;
  *) DIR=. ;;
esac
DIR=$(cd -P "$DIR" && pwd)
ROOT=$(cd -P "$DIR/.." && pwd)
if [ "$#" -eq 0 ]; then
  set -- start
fi
PYTHONPATH="$ROOT/src${PYTHONPATH:+:$PYTHONPATH}" exec "$DIR/python" -B -m leadseek.monitor_cli "$@"
