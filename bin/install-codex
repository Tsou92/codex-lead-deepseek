#!/bin/sh
''''exec "$(d=$0; if [ "${d#*/}" = "$d" ]; then d=./$d; fi; while [ -L "$d" ]; do l=$(readlink "$d"); if [ "${l#/}" != "$l" ]; then d=$l; else d=${d%/*}/$l; fi; done; b=${d%/*}; cd "$b" && pwd)/python" "$0" "$@" # '''
#!/usr/bin/env python3
from pathlib import Path
import sys

sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "src"))
from leadseek.install import main

sys.exit(main())
